{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superpose",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "GRAPH", "class_name": "Graph" },
      { "name": "CHECKER", "class_name": "Checker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Graph"] },
    { "tag": "v2", "new_sqlite_classes": ["Checker"] }
  ],
  // Checks and landings run in a fresh container each, from a public image
  // (plain Node with git), so nothing is built locally.
  "containers": [
    {
      "class_name": "Checker",
      "image": "docker.io/library/node:22-bookworm",
      "max_instances": 8,
      "instance_type": "basic"
    }
  ],
  // No Docker here: containers run only when deployed.
  "dev": { "enable_containers": false },
  // Every claim gets its own repo here: a fork of its line, named <graph>.claim.<id>.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "superpose" }],
  // Every push to any repo in the namespace starts a PushFlow, which reads the
  // commit and records the verdict on the claim (the event has no file list).
  "workflows": [{ "binding": "PUSHES", "name": "superpose-pushes", "class_name": "PushFlow" }],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "superpose" },
        "targets": [{ "type": "workflow", "workflow_name": "superpose-pushes" }]
      }
    ]
  },
  "observability": { "enabled": true }
  // Secrets, set with `wrangler secret put`: ADMIN_TOKEN, AGENT_KEY.
  // Optional vars: LEASE_MS, HEDGE_MS; REPO_HOST=fake for an in-memory git host.
}
